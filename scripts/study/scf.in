&CONTROL
   calculation      = 'relax'
   outdir           = '../tmp/'
   prefix           = 'gr'
   etot_conv_thr    = 1e-05
   forc_conv_thr    = 0.0001
   pseudo_dir       = '../pseudo/'
/
&SYSTEM
   ibrav            = 0
   a                = 2.4623
   c                = 10.0
   nat              = 2
   ntyp             = 1
   ecutwfc          = 60
   occupations      = 'smearing'
   degauss          = 0.02
   smearing         = 'mv'
/
&ELECTRONS
   conv_thr         = 1e-09
   mixing_beta      = 0.7
/
&IONS
   ion_dynamics     = 'bfgs'
/
&CELL
/
&FCP
/
&RISM
/
